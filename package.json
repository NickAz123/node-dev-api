{
    "dependencies": {
        "bcrypt": "^5.1.1",
        "connect-redis": "^10.0.0",
        "dotenv": "^16.4.5",
        "express": "^4.21.0",
        "express-session": "^1.19.0",
        "pg": "^8.23.0",
        "redis": "^6.2.1"
    },
    "name": "dev-api",
    "version": "1.0.0",
    "description": "Faux DB/API I use for local testing applications and content",
    "main": "app.js",
    "type": "module",
    "engines": {
    "node": ">=24.19.0"
    },
    "scripts": {
        "start": "node app.js",
        "dev": "docker compose up -d db && nodemon app.js",
        "db:up": "docker compose up -d db",
        "db:down": "docker compose stop db",
        "db:reset": "docker compose down -v && docker compose up -d db",
        "psql": "docker compose exec db psql -U devnodeadmin -d devnodedb"
    },
